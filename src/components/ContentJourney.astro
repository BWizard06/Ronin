---
import SteelStudy from './SteelStudy.astro';
import { details, eras, culture } from '../data/experience';
---
<div class="journey-flow">
  <div class="motion-pass" data-from="0" data-to=".35" style="--travel:250svh" aria-hidden="true"></div>

  <section class="content-stop inspection" id="craft" data-from=".35" data-to=".35" data-mode="inspection" aria-labelledby="inspection-title" tabindex="-1">
    <div class="content-inner inspection-inner">
      <h2 class="inspection-heading" id="inspection-title">The art<br /><em>of the whole.</em></h2>
      <div class="inspection-space" aria-hidden="true"></div>
      <nav class="inspection-mobile-parts content-interactive" aria-label="Explore katana details">
        {details.map((detail,i)=><button type="button" data-detail={i} data-name={detail.name} aria-pressed={i===0} aria-controls={`detail-${detail.id}`}>{detail.name}</button>)}
      </nav>
      <div class="inspection-copy content-interactive">
        <div class="detail-panels">
          {details.map((detail, i) => <article class:list={['detail-panel', { 'is-selected': i === 0 }]} id={`detail-${detail.id}`} role="region" aria-labelledby={`detail-title-${detail.id}`}>
            <span class="detail-kanji" lang="ja" aria-hidden="true">{detail.kanji}</span>
            <h3 id={`detail-title-${detail.id}`}>{detail.name}</h3>
            <p class="detail-meaning">{detail.meaning}</p>
            {detail.paragraphs.map(paragraph => <p>{paragraph}</p>)}
            {detail.href && <a class="source-link" href={detail.href} target="_blank" rel="noopener noreferrer">{detail.source} <span aria-hidden="true">↗</span></a>}
          </article>)}
        </div>
      </div>
      <label class="light-control content-interactive" for="light-angle"><span>Light <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2"/></svg></span><input id="light-angle" type="range" min="-100" max="100" step="1" value="10" aria-label="Lighting angle" /></label>
    </div>
  </section>

  <div class="motion-pass" data-from=".35" data-to=".455" style="--travel:100svh" aria-hidden="true"></div>
  <SteelStudy />
  <div class="motion-pass" data-from=".455" data-to=".62" style="--travel:130svh" aria-hidden="true"></div>

  <section class="content-stop history-section" id="history" data-from=".62" data-to=".62" data-mode="history" aria-labelledby="history-title" tabindex="-1">
    <div class="content-inner history-inner content-interactive">
      <div class="history-heading"><h2 class="content-title" id="history-title">A thousand years.<br /><em>Still unfolding.</em></h2><p>Follow the line.<br />A craft carried through centuries.</p></div>
      <div class="history-layout">
      <nav class="timeline-controls" aria-label="Japanese sword timeline"><div class="timeline-line" aria-hidden="true"></div>
        {eras.map((era, i) => <button type="button" data-era={i} aria-controls={`era-${i}`} aria-current={i === 0 ? 'step' : undefined}><span>{era.date}</span><small>{era.period}</small></button>)}
      </nav>
      <div class="history-panels">
        {eras.map((era, i) => <article class:list={['era-panel', { 'is-selected': i === 0 }]} id={`era-${i}`} tabindex="-1" aria-labelledby={`era-title-${i}`}>
          <div class="era-visual" aria-hidden="true"><span class="era-year">{era.year}</span><svg class="era-drawing" viewBox="0 0 600 160" fill="none">
            {i === 3 ? <g transform="translate(300 80)"><ellipse rx="67" ry="65"/><ellipse rx="43" ry="46"/><path d="M-8-34h16l7 64h-30zM-55-20Q0-70 55-20M-55 20Q0 70 55 20M-57 0h-9M57 0h9"/></g> : <g transform={i === 2 ? 'translate(0 155) scale(1 -1)' : undefined}><path d={`M125 93 Q310 ${i === 0 ? 165 : 120} 554 49 Q540 82 502 91 Q290 150 125 111 Z`}/><path d="M32 89l89 3v22l-89-3zM119 80v43M126 80v43M39 91l16 20 15-18 15 20 15-18 15 19"/><path class="drawing-accent" d={`M142 108 Q320 ${i === 0 ? 151 : 136} 516 86`}/></g>}
          </svg></div>
          <div class="era-copy"><p class="era-period">{era.period}</p><h3 id={`era-title-${i}`}>{era.title}</h3><p>{era.body}</p><p class="era-note">{era.note}</p><a class="source-link" href={era.href} target="_blank" rel="noopener noreferrer">{era.source} <span aria-hidden="true">↗</span></a></div>
        </article>)}
      </div>
      </div>
    </div>
  </section>

  <div class="motion-pass" data-from=".62" data-to=".92" style="--travel:190svh" aria-hidden="true"></div>

  <section class="content-stop culture-bridge" id="connections" data-from=".92" data-to=".92" data-mode="bridge" aria-labelledby="bridge-title">
    <div class="content-inner bridge-inner">
      <div class="bridge-copy">
        <h2 id="bridge-title">From the hand.<br /><em>Into the landscape.</em></h2>
        <p>The waves in a guard. The curve of a gate. A branch in bloom.<br />Beyond the blade, our journey follows an attention to form, nature and the passing seasons.</p>
      </div>
      <svg class="bridge-gate" viewBox="0 0 300 300" fill="none" aria-hidden="true"><path pathLength="1" d="M36 50Q150 75 264 50M46 65Q150 84 254 65M65 105H235M92 76L78 270M208 76L222 270M150 80V105"/></svg>
    </div>
  </section>

  <section class="content-stop culture-section" id="beyond" data-from=".92" data-to=".92" data-mode="culture" aria-label="Through the torii, into the blossoms" tabindex="-1">
    <div class="content-inner culture-inner">
      <article class="culture-story torii-story content-interactive">
        <span class="culture-name">Torii</span><h2 class="content-title">Through<br /><em>the threshold.</em></h2>
        <p>{culture[0].body}</p><a class="source-link" href={culture[0].href} target="_blank" rel="noopener noreferrer">{culture[0].source} ↗</a>
      </article>
      <article class="culture-story sakura-story content-interactive">
        <span class="culture-name">Sakura</span><h2 class="content-title">A moment,<br /><em>in bloom.</em></h2>
        <p>{culture[1].body}</p><a class="source-link" href={culture[1].href} target="_blank" rel="noopener noreferrer">{culture[1].source} ↗</a>
      </article>
      <div class="culture-controls content-interactive" role="group" aria-label="Explore the cultural model" inert aria-hidden="true">
        <span class="culture-drag-hint">Drag to turn</span>
        <div class="culture-turn-controls">
          <button type="button" data-culture-action="left" aria-label="Rotate the model left" title="Turn left"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m13 7-5 5 5 5M8 12h11"/></svg></button>
          <button type="button" data-culture-action="reset" aria-label="Reset the model view" title="Reset view"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1.4 7M4 4v6h6"/></svg></button>
          <button type="button" data-culture-action="right" aria-label="Rotate the model right" title="Turn right"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m11 7 5 5-5 5M5 12h11"/></svg></button>
        </div>
        <button class="culture-breeze" type="button" data-culture-action="breeze" aria-label="Send a breeze through the cherry blossoms"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 8h12a3 3 0 1 0-3-3M2 12h17a3 3 0 1 1-3 3M5 16h4"/></svg><span>A little breeze</span></button>
      </div>
    </div>
  </section>

  <div class="motion-pass" data-from=".92" data-to="1" style="--travel:140svh" aria-hidden="true"></div>
  <div class="journey-end" aria-hidden="true"></div>
</div>
