---
import '@fontsource/anton/latin-400.css';
import '@fontsource/anton/latin-ext-400.css';
import '../styles/global.css';
import '../styles/content.css';
import '../styles/glossary.css';
import '../styles/responsive.css';
import KatanaFallback from '../components/KatanaFallback.astro';
import ContentJourney from '../components/ContentJourney.astro';
import Glossary from '../components/Glossary.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#e8e8e3" />
    <meta name="description" content="RŌNIN. An interactive journey through the form, craft and history of the Japanese sword. A 3D experience by Ben Brändle." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/models/ronin-katana-v04.glb" as="fetch" type="model/gltf-binary" crossorigin="anonymous" />
    <title>RŌNIN. Steel shaped by centuries.</title>
  </head>
  <body>
    <LoadingScreen />
    <a class="skip-link" href="#craft">Skip to exploring the katana</a>
    <Glossary />
    <main>
      <div class="journey is-still" id="top">
        <section class="stage" aria-label="The form and history of the Japanese sword" data-scene="whole">
          <div class="stage-texture" aria-hidden="true"></div>
          <div class="model-stage" id="whole" role="group" tabindex="-1" aria-label="Complete katana. At the end of the experience, drag or use left and right arrow keys to turn it. Home resets the view."></div>
          <svg class="inspection-leader" aria-hidden="true"><path/><circle r="2"/></svg>
          <svg class="culture-thread" aria-hidden="true"><path/></svg>
          <div class="part-hotspots" aria-label="Select a katana detail" inert>
            {[['blade',1,'Hamon'],['grip',2,'Tsuka'],['guard',3,'Tsuba'],['saya',4,'Saya']].map(([part,index,label]) => <button type="button" class="part-hotspot" data-part={part} data-detail={index} data-name={label} aria-label={`Explore ${label}`} aria-pressed="false"><span aria-hidden="true">+</span><small>{label}</small></button>)}
          </div>
          <div class="fallback-object"><KatanaFallback /></div>

          <div class="editorial opening" data-moment="opening">
            <h1>RŌNIN</h1>
            <p>Steel shaped<br />by centuries.</p>
          </div>
          <section class="editorial type-equivalent" data-moment="craft" aria-labelledby="craft-title">
            <h2 id="craft-title">Japanese <em>craftsmanship.</em></h2>
          </section>
          <section class="editorial type-equivalent" data-moment="glass" aria-labelledby="glass-title">
            <h2 id="glass-title">Steel.</h2>
          </section>
          <section class="editorial type-equivalent" data-moment="hand" aria-labelledby="hand-title">
            <h2 id="hand-title"><em>by hand.</em></h2>
          </section>
          <section class="editorial type-equivalent" data-moment="assembly" aria-labelledby="assembly-title">
            <h2 id="assembly-title">Every <em>detail</em> matters.</h2>
          </section>
          <section class="editorial returning" data-moment="return" aria-labelledby="return-title">
            <h2 id="return-title">RŌNIN</h2>
            <p><em>Still taking shape.</em></p>
          </section>

          <button class="begin" aria-label="Continue into the history of the katana"><svg viewBox="0 0 32 48" fill="none" aria-hidden="true"><path d="M16 2v40M4 30l12 12 12-12" stroke="currentColor" stroke-width="1.5" /></svg></button>
          <div class="free-controls" inert aria-hidden="true">
            <span>Drag to turn.</span>
            <button class="reset-view" aria-label="Reset the katana view" title="Reset view"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1.4 7M4 4v6h6" stroke="currentColor" stroke-width="1.4" /></svg></button>
          </div>
          <p class="unavailable-message" role="status">The 3D view is unavailable. You can still read the page below.</p>
        </section>
        <ContentJourney />
      </div>
      <footer class="colophon flex items-center justify-between">
        <a href="https://braendle.tech/">By Ben Brändle</a>
        <a href="#top" data-restart>Back to start <span aria-hidden="true">↗</span></a>
      </footer>
    </main>
    <script>import '../scripts/main';</script>
  </body>
</html>
